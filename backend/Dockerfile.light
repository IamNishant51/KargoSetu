# === KargoSetu slim inference image (Render free tier: 512MB RAM) ===
# The HF Dockerfile stays for full-training deploys.
# This image: no TF/training, 1 uvicorn worker, loads models/model.onnx.

FROM python:3.11-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3-dev gcc libssl-dev curl \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements-light.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-light.txt

COPY prisma ./prisma
RUN prisma generate

FROM python:3.11-slim

# libatomic1 is REQUIRED: prisma-client-py runs a prebuilt node binary
# (for `prisma db push` in CMD) that links against libatomic.so.1,
# which python:3.11-slim does not ship. Without it the boot crashes with
# "error while loading shared libraries: libatomic.so.1".
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl curl libatomic1 \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser -d /app appuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
# Reuse the builder's Prisma cache (node + engines) instead of re-downloading
# at boot: appuser's HOME is /app, so it must live in /app/.cache, owned by
# appuser. (Builder ran as root → /root/.cache, invisible to appuser.)
COPY --from=builder /root/.cache/prisma-python /app/.cache/prisma-python
ENV PATH="/opt/venv/bin:$PATH"
ENV XDG_CACHE_HOME=/app/.cache
# CRITICAL: prisma-client-py resolves its engine binaries via $HOME-derived
# paths (it ignores XDG_CACHE_HOME) — and Docker does NOT update $HOME on
# `USER appuser` (it stays /root). Belt-and-braces: set $HOME plus Prisma's
# own explicit overrides (see prisma/_config.py: PRISMA_HOME_DIR,
# PRISMA_BINARY_CACHE_DIR, PRISMA_NODEENV_CACHE_DIR). Without these, boot
# fails with "Permission denied:
# '/root/.cache/prisma-python/binaries/.../query-engine...'".
# NOTE: PRISMA_BINARY_CACHE_DIR embeds prisma-engine version/hash — update it
# when bumping the `prisma` package (must match `prisma --version` output).
ENV HOME=/app
ENV PRISMA_HOME_DIR=/app
ENV PRISMA_NODEENV_CACHE_DIR=/app/.cache/prisma-python/nodeenv
ENV PRISMA_BINARY_CACHE_DIR=/app/.cache/prisma-python/binaries/5.17.0/393aa359c9ad4a4bb28630fb5613f9c281cde053

COPY . .

# Prebuilt ONNX snapshot baked in when present (exported via CI/local training).
RUN mkdir -p /app/models && chown -R appuser:appuser /app

USER appuser

# Render injects $PORT; default 8000 for local `docker run`.
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/api/health/ping || exit 1

# Single worker: 512MB cannot hold gunicorn -w 8 + TF. Inference + math
# are async/light; one worker serves the demo + judge traffic fine.
# NOTE: no `prisma db push` at boot, deliberately. The direct URL
# (db.*.supabase.co:5432) is unreachable from Render's egress (P1001 —
# documented Render+Supabase issue), and `&&` would kill the boot before
# uvicorn binds a port. Schema is deployed out-of-band (local/CI with
# DIRECT_URL); the app only needs the pooled DATABASE_URL at runtime.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
