generator client {
  provider  = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Port {
  id               String   @id @default(uuid())
  name             String   @unique
  chartedDepth     Float
  permissibleDraft Float
  brackishDensity  Float    @default(1.025)
  lat              Float
  lon              Float
  typicalTidalRange Float   @default(0.0)
  maxVesselClass    String   @default("Capesize")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Vessel {
  id               String   @id @default(uuid())
  name             String   @unique
  capacity         Int
  laden_draft      Float
  ballast_draft    Float    @default(0.0)
  daily_cost       Int
  block_coeff      Float    @default(0.85)
  speed_knots      Float    @default(12.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Requisition {
  id            String   @id @default(uuid())
  volume_mt     Float
  destPortName  String   @map("dest_port")
  commodity     String
  status        String   @default("Pending")
  origin        String   @default("Global")
  createdAt     DateTime @default(now())

  @@index([commodity])
  @@index([destPortName])
}

model MLModel {
  id        String   @id @default(uuid())
  version   String
  trainedAt DateTime
  mape      Float
  rmse      Float
  isActive  Boolean
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  // Optional for Google login
  name         String?
  googleId     String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
