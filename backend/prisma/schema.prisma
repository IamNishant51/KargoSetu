generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Port {
  id               String   @id @default(uuid())
  name             String   @unique
  chartedDepth     Float
  permissibleDraft Float
  brackishDensity  Float    @default(1.025)
  lat              Float
  lon              Float
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Vessel {
  id               String   @id @default(uuid())
  name             String   @unique
  capacity         Int
  laden_draft      Float
  daily_cost       Int
  block_coeff      Float    @default(0.85)
  speed_knots      Float    @default(12.0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Requisition {
  id            String   @id @default(uuid())
  volume_mt     Float
  dest_port     String
  commodity     String
  status        String   @default("Pending")
  origin        String   @default("Global")
  createdAt     DateTime @default(now())
}
